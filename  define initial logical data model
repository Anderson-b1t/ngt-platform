[32m+[m[32m* CategoriaId[m
[32m+[m[32m* Nombre[m
[32m+[m[32m* Descripcion[m
[32m+[m[32m* Precio[m
[32m+[m[32m* Stock[m
[32m+[m[32m* TipoProducto[m
[32m+[m[32m* Activo[m
[32m+[m
[32m+[m[32mTipos conceptuales:[m
[32m+[m
[32m+[m[32m* ComponentePC[m
[32m+[m[32m* Comic[m
[32m+[m[32m* Manga[m
[32m+[m
[32m+[m[32mRelación:[m
[32m+[m
[32m+[m[32m* Una Categoria puede contener muchos Productos.[m
[32m+[m[32m* Un Producto pertenece a una Categoria.[m
[32m+[m
[32m+[m[32m## ComponentePC[m
[32m+[m
[32m+[m[32mRepresenta la información técnica adicional de un Producto utilizado para ensamblar computadoras.[m
[32m+[m
[32m+[m[32mAtributos:[m
[32m+[m
[32m+[m[32m* ProductoId[m
[32m+[m[32m* TipoComponente[m
[32m+[m[32m* Marca[m
[32m+[m[32m* Modelo[m
[32m+[m
[32m+[m[32mTipos conceptuales iniciales:[m
[32m+[m
[32m+[m[32m* Procesador[m
[32m+[m[32m* PlacaMadre[m
[32m+[m[32m* MemoriaRAM[m
[32m+[m[32m* TarjetaGrafica[m
[32m+[m[32m* Almacenamiento[m
[32m+[m[32m* FuentePoder[m
[32m+[m[32m* Gabinete[m
[32m+[m[32m* Refrigeracion[m
[32m+[m
