[32m+[m
[32m+[m[32m* PedidoId[m
[32m+[m[32m* UsuarioId[m
[32m+[m[32m* Total[m
[32m+[m[32m* Estado[m
[32m+[m[32m* FechaPedido[m
[32m+[m
[32m+[m[32mEstados conceptuales iniciales:[m
[32m+[m
[32m+[m[32m* Pendiente[m
[32m+[m[32m* Pagado[m
[32m+[m[32m* EnPreparacion[m
[32m+[m[32m* Enviado[m
[32m+[m[32m* Completado[m
[32m+[m[32m* Cancelado[m
