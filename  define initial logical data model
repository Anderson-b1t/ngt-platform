[32m+[m[32m* CategoriaId[m
[32m+[m[32m* Nombre[m
[32m+[m[32m* Descripcion[m
[32m+[m[32m* Activa[m
[32m+[m
[32m+[m[32mRelación:[m
[32m+[m
[32m+[m[32mCategoria 1 ─── N Producto[m
[32m+[m
[32m+[m[32m## Producto[m
[32m+[m
[32m+[m[32mRepresenta cualquier artículo comercializable dentro de NGT Platform.[m
[32m+[m
