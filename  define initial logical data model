[32m+[m[32m* Nombre[m
[32m+[m[32m* EstadoValidacion[m
[32m+[m[32m* FechaCreacion[m
[32m+[m[32m* FechaActualizacion[m
[32m+[m
[32m+[m[32mEstados conceptuales:[m
[32m+[m
[32m+[m[32m* Incompleta[m
[32m+[m[32m* Valida[m
[32m+[m[32m* Incompatible[m
